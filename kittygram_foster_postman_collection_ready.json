{
  "info": {
    "_postman_id": "3b1d3ef5-0f3d-4cbe-a6c1-foster-collection-ready",
    "name": "Kittygram Foster API (Auto Token)",
    "description": "Коллекция для проверки авторизации, статусов владения и договоров передержки в проекте Kittygram Foster. Порядок работы: 1) выполнить запрос Login; 2) токен сохранится автоматически в переменную token; 3) после этого можно запускать остальные запросы без ручного копирования токена.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:9000"
    },
    {
      "key": "username",
      "value": "olga"
    },
    {
      "key": "password",
      "value": "olgapass"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "catId",
      "value": "1"
    },
    {
      "key": "contractId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "description": "Первый запрос коллекции. Отправляет логин и пароль пользователя, получает auth_token и автоматически сохраняет его в переменную token. После успешного выполнения остальные запросы можно запускать без ручного ввода токена.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/token/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "token",
            "login",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус ответа 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var data = pm.response.json();",
              "pm.test('Токен получен', function () {",
              "    pm.expect(data).to.have.property('auth_token');",
              "});",
              "if (data.auth_token) {",
              "    pm.collectionVariables.set('token', data.auth_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get Foster Cats",
      "request": {
        "method": "GET",
        "description": "Возвращает список котов, находящихся на передержке. Токен подставляется автоматически из переменной token после выполнения запроса Login.",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cats/foster/?active_contract=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cats",
            "foster",
            ""
          ],
          "query": [
            {
              "key": "active_contract",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "3. Create Ownership Status",
      "request": {
        "method": "POST",
        "description": "Назначает коту статус владения. Для работы нужно указать идентификатор кота в переменной catId. Заголовок Authorization формируется автоматически на основе сохраненного токена.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cat\": {{catId}},\n  \"status\": \"foster\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/ownership-statuses/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ownership-statuses",
            ""
          ]
        }
      }
    },
    {
      "name": "4. Create Foster Contract",
      "request": {
        "method": "POST",
        "description": "Создает договор передержки для кота из переменной catId. После успешного выполнения идентификатор созданного договора автоматически сохраняется в переменную contractId и используется в следующем запросе.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cat\": {{catId}},\n  \"start_date\": \"2026-03-30\",\n  \"end_date\": \"2026-04-15\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/foster-contracts/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "foster-contracts",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var data = pm.response.json();",
              "if (data.id) {",
              "    pm.collectionVariables.set('contractId', String(data.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Close Foster Contract",
      "request": {
        "method": "POST",
        "description": "Закрывает договор передержки по идентификатору из переменной contractId. Значение contractId можно подставить вручную или получить автоматически после успешного запроса Create Foster Contract.",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/foster-contracts/{{contractId}}/close/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "foster-contracts",
            "{{contractId}}",
            "close",
            ""
          ]
        }
      }
    }
  ]
}
